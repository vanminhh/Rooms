{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/staging-guard.mjs",
            "timeout": 10,
            "statusMessage": "Kiểm tra vùng nháp chờ duyệt"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/agent-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
