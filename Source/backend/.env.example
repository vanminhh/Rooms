# Copy to .env and fill locally. Never commit real credentials.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
APP_URL=
NODE_ENV=
# 32-byte key encoded as base64. Losing it makes stored ID numbers unreadable.
CCCD_KEY=

# Shared bank webhook secret as text. Unset by default.
BANK_WEBHOOK_SECRET=
# Cloudinary credentials as cloudinary://<api_key>:<api_secret>@<cloud_name>. Unset by default.
CLOUDINARY_URL=
# Number of trusted reverse proxies as an integer from 0 to 10. Default: 0.
# TRUST_PROXY_HOPS=
# HTTP listen port as an integer. Default: 3000.
# PORT=
# Prisma interactive transaction timeout as an integer in milliseconds (at least 30000). Default: 30000.
PRISMA_TX_TIMEOUT_MS=

# EX-8: set MAIL_PROVIDER=resend and fill both values to send real emails.
# With no provider: development/test logs emails; production returns MAIL_UNAVAILABLE.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=

# CHAT-02: Claude API key for the public chatbot. Empty: POST /public/chat answers CHAT_UNAVAILABLE.
ANTHROPIC_API_KEY=
