{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/staging-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra vùng nháp chờ duyệt"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
